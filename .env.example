# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) during development; switch to live (sk_live_...) to go live.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Get this from Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# Register: https://<your-domain>/api/webhooks/stripe  (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Twilio SMS ────────────────────────────────────────────────────────────────
# Sign up at https://www.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# A Twilio phone number in E.164 format, e.g. +61400000000
TWILIO_FROM_NUMBER=+61400000000

# ── Business / Owner ─────────────────────────────────────────────────────────
# The owner's mobile number (E.164). New-booking SMS will be sent here.
OWNER_PHONE=+61400000000

# ── Google Sheets ─────────────────────────────────────────────────────────────
# 1. Create a Google Cloud project → enable "Google Sheets API"
# 2. Create a service account → download the JSON key
# 3. Paste the ENTIRE JSON content (single line) as the value below
# 4. Share your Google Sheet with the service account email (Editor access)
# 5. Copy the spreadsheet ID from the sheet URL:
#    https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# ── Nitro / Vercel ────────────────────────────────────────────────────────────
# Set this in the Vercel dashboard → Project Settings → Environment Variables
# so nitro builds for the Vercel target instead of Cloudflare.
NITRO_PRESET=vercel
